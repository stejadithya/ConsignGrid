# Copy to backend/.env for local development. Never commit real secrets.
# development | test | staging (strong secret, demo seed allowed) | production
APP_ENV=development
# ── Brand Pack (docs/whitelabel/04_CUSTOMER_PLAYBOOK.md) ──
# The software's name (ours or a white-label reseller's).
APP_DISPLAY_NAME=ConsignGrid
# The supplier running the consignment programme, as dealers know it. Empty = APP_DISPLAY_NAME.
COMPANY_NAME=
SUPPORT_EMAIL=
DATABASE_URL=postgresql+psycopg://tyreworld:tyreworld@localhost:5432/tyreworld
# Serverless hosting (Vercel + Neon pooled URL): set both to true. postgres:// URLs are accepted.
DB_DISABLE_POOL=false
DB_DISABLE_PREPARED_STATEMENTS=false

# Generate a strong secret for any shared or production environment, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_MINUTES=720
AUTH_COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]

# Business policy (see docs/DECISION_LOG.md)
DEFAULT_CURRENCY=AUD
AUTO_ALLOCATE_ON_CREATE=true
ALLOCATION_POLICY=PRIORITY_THEN_OLDEST
INVOICE_DUE_DAYS_DEFAULT=30
# Legal entity on invoices and delivery notes. Empty = COMPANY_NAME.
INVOICE_ISSUER_NAME=
INVOICE_ISSUER_DETAILS=1 Warehouse Road, Example City · Tax no. 00 000 000 000

# Stock checks (release 1.11): days a dealer has to find tyres not found before they are invoiced as sold.
# STOCKTAKE_FIND_DAYS=5
# Protects the daily jobs (photo clean-up, stock-check invoicing) called by Vercel Cron.
# CRON_SECRET=
