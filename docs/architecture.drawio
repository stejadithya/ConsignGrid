Cell id="m11" value="Replenishment &amp; deliveries" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="650" y="285" width="165" height="40" as="geometry"/></mxCell><mxCell id="m12" value="Inter-reseller transfers" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="825" y="285" width="165" height="40" as="geometry"/></mxCell><mxCell id="m20" value="Purchasing &amp; receipts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="475" y="335" width="165" height="40" as="geometry"/></mxCell><mxCell id="m21" value="Stocktakes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="650" y="335" width="165" height="40" as="geometry"/></mxCell><mxCell id="m22" value="Invoicing (+ export)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="825" y="335" width="165" height="40" as="geometry"/></mxCell><mxCell id="m30" value="Consignment targets" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="475" y="385" width="165" height="40" as="geometry"/></mxCell><mxCell id="m31" value="Reporting &amp; dashboard" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="650" y="385" width="165" height="40" as="geometry"/></mxCell><mxCell id="m32" value="Audit log" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="825" y="385" width="165" height="40" as="geometry"/></mxCell><mxCell id="inv" value="&lt;b&gt;Inventory core&lt;/b&gt; — the only code that changes stock&lt;br&gt;Double-entr