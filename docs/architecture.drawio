<mxfile host="app.diagrams.net"><diagram name="Architecture" id="arch"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1420" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;TyreGrow — Architecture&lt;/b&gt; (modular monolith · Vercel + Neon)" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="160" y="10" width="1220" height="36" as="geometry"/></mxCell><mxCell id="staff" value="Dealership staff&lt;br&gt;(Admin · Manager · Warehouse · Sales rep · Finance)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="40" height="70" as="geometry"/></mxCell><mxCell id="resell" value="Reseller users&lt;br&gt;(read-only, own data only)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="40" height="70" as="geometry"/></mxCell><mxCell id="vercel" value="Vercel (team: TYREGROW)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#f8fafc;strokeColor=#0f172a;dashed=1;" vertex="1" parent="1"><mxGeometry x="160" y="60" width="880" height="640" as="geometry"/></mxCell><mxCell id="fe" value="&lt;b&gt;tyregrow&lt;/b&gt; — web app&lt;br&gt;Next.js · React · TypeScript · Tailwind&lt;br&gt;Root dir: &lt;i&gt;frontend/&lt;/i&gt;&lt;br&gt;Branding: src/config/branding.ts&lt;br&gt;/api/* rewrite → API (same origin)&lt;br&gt;httpOnly SameSite=Strict session cookie" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#ccfbf1;strokeColor=#0f766e;" vertex="1" parent="1"><mxGeometry x="180" y="150" width="240" height="170" as="geometry"/></mxCell><mxCell id="be" value="tyregrow-api — Python function (FastAPI) ·