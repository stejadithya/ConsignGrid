# Brand Pack (frontend). Copy to .env.local. All optional; see docs/whitelabel/04_CUSTOMER_PLAYBOOK.md.
# NEXT_PUBLIC_* values are built into the bundle: rebuild after changing them.
NEXT_PUBLIC_BRAND_NAME=ConsignGrid
# The supplier as dealers know it ("Acme Tyres will call you"). Empty = NEXT_PUBLIC_BRAND_NAME.
NEXT_PUBLIC_BRAND_COMPANY=
NEXT_PUBLIC_BRAND_DESCRIPTOR=Consignment Operations
NEXT_PUBLIC_BRAND_TAGLINE=
# Wordmark in public/ and its intrinsic size (keeps the aspect ratio).
NEXT_PUBLIC_BRAND_LOGO=/brand/logo.svg
NEXT_PUBLIC_BRAND_LOGO_WIDTH=960
NEXT_PUBLIC_BRAND_LOGO_HEIGHT=218
NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=
# Accent colours (hex). Fill always carries dark text; ACCENT_TEXT must reach 4.5:1 on white.
NEXT_PUBLIC_BRAND_ACCENT=
NEXT_PUBLIC_BRAND_ACCENT_HOVER=
NEXT_PUBLIC_BRAND_ACCENT_SOFT=
NEXT_PUBLIC_BRAND_ACCENT_TEXT=
